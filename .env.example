# Perfil de produção usado no Render
SPRING_PROFILES_ACTIVE=prod

# Conexão direta do Neon. Não use o host com sufixo -pooler porque o Flyway
# executa as migrações de banco durante a inicialização da aplicação.
DB_URL=jdbc:postgresql://<host-direto-do-neon>/<banco>?sslmode=require
DB_USERNAME=<role-do-neon>
DB_PASSWORD=<senha-do-neon>

# Sessão e origens oficiais. Gere AUTH_JWT_SECRET_BASE64 a partir de pelo
# menos 32 bytes aleatórios e mantenha o valor somente no cofre do Render.
AUTH_JWT_SECRET_BASE64=<segredo-base64-com-32-bytes-ou-mais>
AUTH_JWT_ISSUER=https://truck-life-simulator-api.onrender.com
AUTH_JWT_AUDIENCE=truck-life-simulator
AUTH_ALLOWED_ORIGINS=https://luislipinski.github.io

# Entrega de e-mail. Enquanto AUTH_EMAIL_TEST_MODE=true, o destinatário real
# é substituído por AUTH_EMAIL_TEST_RECIPIENT. Só altere para false quando o
# domínio/remetente estiver validado e o envio real estiver pronto.
AUTH_EMAIL_PROVIDER=resend
RESEND_API_KEY=<chave-resend>
AUTH_EMAIL_FROM=Truck Life Simulator <onboarding@resend.dev>
AUTH_FRONTEND_BASE_URL=https://luislipinski.github.io/truck-life-simulator
AUTH_EMAIL_TEST_MODE=true
AUTH_EMAIL_TEST_RECIPIENT=delivered@resend.dev

# Limites de segurança. Os valores abaixo são os padrões da aplicação e podem
# ser ajustados por ambiente sem alteração de código.
AUTH_REGISTER_RATE_LIMIT_ATTEMPTS=5
AUTH_REGISTER_RATE_LIMIT_WINDOW=PT1H
AUTH_VERIFY_EMAIL_RATE_LIMIT_ATTEMPTS=10
AUTH_VERIFY_EMAIL_RATE_LIMIT_WINDOW=PT30M
AUTH_RESEND_VERIFICATION_RATE_LIMIT_ATTEMPTS=3
AUTH_RESEND_VERIFICATION_RATE_LIMIT_WINDOW=PT1H
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=PT15M
AUTH_REFRESH_RATE_LIMIT_ATTEMPTS=30
AUTH_REFRESH_RATE_LIMIT_WINDOW=PT1M

# O Render fornece PORT automaticamente.
